{
  "info": {
    "name": "Arad Billboards API",
    "description": "Complete API collection for Arad Billboards system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "billboard_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "city_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "partner_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"کاربر تست\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    pm.collectionVariables.set('user_id', response.user.id);",
                  "    console.log('Token saved:', response.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@arad.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    pm.collectionVariables.set('user_id', response.user.id);",
                  "    console.log('Login successful, token saved');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Cities",
      "item": [
        {
          "name": "Get All Cities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/cities?status=active",
              "host": ["{{base_url}}"],
              "path": ["cities"],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.items && response.items.length > 0) {",
                  "        pm.collectionVariables.set('city_id', response.items[0].id);",
                  "        console.log('City ID saved:', response.items[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create City (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"شهر تست\",\n  \"slug\": \"test-city\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cities",
              "host": ["{{base_url}}"],
              "path": ["cities"]
            }
          }
        },
        {
          "name": "Update City (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"شهر تست بروزرسانی شده\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cities/{{city_id}}",
              "host": ["{{base_url}}"],
              "path": ["cities", "{{city_id}}"]
            }
          }
        },
        {
          "name": "Delete City (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cities/{{city_id}}",
              "host": ["{{base_url}}"],
              "path": ["cities", "{{city_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Partners",
      "item": [
        {
          "name": "Get All Partners",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/partners?status=active",
              "host": ["{{base_url}}"],
              "path": ["partners"],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.items && response.items.length > 0) {",
                  "        pm.collectionVariables.set('partner_id', response.items[0].id);",
                  "        console.log('Partner ID saved:', response.items[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Partner (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"شریک تست\",\n  \"contactInfo\": \"اطلاعات تماس تست\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/partners",
              "host": ["{{base_url}}"],
              "path": ["partners"]
            }
          }
        }
      ]
    },
    {
      "name": "Billboards",
      "item": [
        {
          "name": "Get All Billboards",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/billboards?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["billboards"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.items && response.items.length > 0) {",
                  "        pm.collectionVariables.set('billboard_id', response.items[0].id);",
                  "        console.log('Billboard ID saved:', response.items[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Billboards with Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/billboards?search=تهران&labels=available,reserved&ownership=شرکت تبلیغاتی آراد&city=تهران&page=1&limit=5",
              "host": ["{{base_url}}"],
              "path": ["billboards"],
              "query": [
                {
                  "key": "search",
                  "value": "تهران"
                },
                {
                  "key": "labels",
                  "value": "available,reserved"
                },
                {
                  "key": "ownership",
                  "value": "شرکت تبلیغاتی آراد"
                },
                {
                  "key": "city",
                  "value": "تهران"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Get Billboard by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/billboards/{{billboard_id}}",
              "host": ["{{base_url}}"],
              "path": ["billboards", "{{billboard_id}}"]
            }
          }
        },
        {
          "name": "Create Billboard (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billboardCode\": \"T999\",\n  \"title\": \"بیلبورد تست\",\n  \"length\": 6.0,\n  \"width\": 3.0,\n  \"squareMeter\": 18.0,\n  \"position\": \"موقعیت تست\",\n  \"region\": \"منطقه تست\",\n  \"priceNumber\": 500.0,\n  \"cityId\": {{city_id}},\n  \"partnerId\": {{partner_id}},\n  \"isReserved\": false,\n  \"isEmpty\": true,\n  \"isInactive\": false,\n  \"isBroadcasting\": false,\n  \"isCultural\": false,\n  \"imageUrl\": \"/images/products/h1.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/billboards",
              "host": ["{{base_url}}"],
              "path": ["billboards"]
            }
          }
        }
      ]
    },
    {
      "name": "Product Cards",
      "item": [
        {
          "name": "Get All Product Cards",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/product-cards?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["product-cards"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product Card by Billboard ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/product-cards/billboard/{{billboard_id}}",
              "host": ["{{base_url}}"],
              "path": ["product-cards", "billboard", "{{billboard_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Get User Reservations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reservations?status=confirmed",
              "host": ["{{base_url}}"],
              "path": ["reservations"],
              "query": [
                {
                  "key": "status",
                  "value": "confirmed"
                }
              ]
            }
          }
        },
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billboardId\": {{billboard_id}},\n  \"reservedFrom\": \"2024-12-01T00:00:00Z\",\n  \"reservedTo\": \"2024-12-31T23:59:59Z\",\n  \"notes\": \"رزرو تست\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reservations",
              "host": ["{{base_url}}"],
              "path": ["reservations"]
            }
          }
        }
      ]
    },
    {
