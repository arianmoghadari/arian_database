              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"billboardId\": {{billboard_id}},\n      \"qty\": 2,\n      \"unitPrice\": 500.0,\n      \"discountPercent\": 10\n    }\n  ],\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
